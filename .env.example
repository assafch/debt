# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/debt_crm

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRY=8h

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# ─── Priority Connect API ────────────────────────────────────────────────────
# Format: "API_KEY:PAT" - will be Base64-encoded for Basic auth
PRIORITY_API_KEY_PAT=4136A6C2563840AA91B56F869C2550BB:PAT
PRIORITY_INVOICES_URL=https://p.priority-connect.online/odata/Priority/tabp008h.ini/a051014/TFNCITEMS2ONE
PRIORITY_CUSTOMERS_URL=https://p.priority-connect.online/odata/Priority/tabp008h.ini/a051014/CUSTOMERS

# ─── Sync Schedule ───────────────────────────────────────────────────────────
# node-cron expression (default: every 4 hours)
SYNC_CRON_EXPRESSION=0 */4 * * *

# ─── Initial Admin User (seed) ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=Change_Me_Immediately_123!
